#!/usr/bin/env python3
"""Repo-local wiki lint for the LLM-wiki knowledge vault.

The command has two layers:
- structure: deterministic filesystem and Markdown consistency checks.
- semantic: an agent-review packet for conflict, stale synthesis, duplicate,
  unsupported synthesis, and missing bridge-note review.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import re
import subprocess
import sys
from collections import Counter
from dataclasses import dataclass, field
from pathlib import Path
from urllib.parse import unquote, urlparse


REPO_ROOT = Path(__file__).resolve().parent.parent
RAW_DIR = REPO_ROOT / "raw"
AGENT_DIR = REPO_ROOT / "agent"
WIKI_DIR = REPO_ROOT / "wiki"
WIKI_SOURCES_DIR = WIKI_DIR / "sources"
WIKI_NOTES_DIR = WIKI_DIR / "notes"
WIKI_META_DIR = WIKI_DIR / "meta"
INDEX_PATH = WIKI_DIR / "index.md"
VALID_NOTE_TYPES = {"entity", "concept", "comparison", "overview", "synthesis"}
REQUIRED_AGENT_FILES = ("source.md", "metadata.json", "refs.json")
LOCAL_LINK_RE = re.compile(r"(?<!!)\[[^\]]+\]\(([^)]+)\)")
MARKDOWN_LINK_RE = re.compile(r"(?<!!)\[[^\]]+\]\([^)]+\)")
FRONTMATTER_RE = re.compile(r"\A---\n(.*?)\n---\n", re.DOTALL)
TYPE_RE = re.compile(r"^type:\s*([A-Za-z_-]+)\s*$", re.MULTILINE)
SOURCE_LINK_RE = re.compile(r"\]\(\.\./sources/[^)]+\.md\)|wiki/sources/[A-Za-z0-9_.\-/]+\.md")
WORD_RE = re.compile(r"[a-z0-9]+")
BACKTICK_TERM_RE = re.compile(r"`([^`\n]{2,60})`")
HEADING_RE = re.compile(r"^(#{1,6})\s+(.+?)\s*$")


SEMANTIC_TOKEN_STOP = {
    "about",
    "across",
    "after",
    "against",
    "agent",
    "agents",
    "also",
    "and",
    "are",
    "because",
    "benchmark",
    "benchmarks",
    "between",
    "can",
    "code",
    "design",
    "does",
    "eda",
    "en",
    "for",
    "from",
    "generation",
    "into",
    "llm",
    "llms",
    "more",
    "note",
    "over",
    "page",
    "paper",
    "rather",
    "reports",
    "research",
    "rtl",
    "source",
    "system",
    "than",
    "that",
    "the",
    "their",
    "this",
    "through",
    "uses",
    "using",
    "verification",
    "when",
    "where",
    "with",
    "wiki",
    "would",
    "zh",
}

NOISY_BRIDGE_TERM_RE = re.compile(
    r"^(?:gpt|claude|gemini|llama|qwen|deepseek|mistral|codegen|codellama)(?:-[a-z0-9]+)*$"
    r"|^pass-[0-9]+$"
    r"|^[0-9]+(?:-[0-9]+)*$"
    r"|^[a-z]+-[0-9]+(?:-[a-z0-9]+)*$"
)


@dataclass
class Finding:
    level: str
    message: str
    path: str | None = None

    def render(self) -> str:
        prefix = f"- {self.level}: "
        if self.path:
            return f"{prefix}`{self.path}` - {self.message}"
        return f"{prefix}{self.message}"


@dataclass
class LintResult:
    structure: list[Finding] = field(default_factory=list)
    semantic: list[str] = field(default_factory=list)
    qmd_status: str = ""

    def counts(self) -> Counter:
        counts: Counter = Counter()
        for finding in self.structure:
            counts[finding.level] += 1
        return counts


@dataclass
class PageProfile:
    path: Path
    title: str
    page_type: str | None
    title_line: int
    slug_tokens: set[str]
    title_tokens: set[str]
    body_tokens: set[str]
    backtick_terms: set[str]
    source_slugs: set[str]


@dataclass
class DuplicateNoteCandidate:
    score: float
    left: PageProfile
    right: PageProfile
    rationale: list[str]


@dataclass
class UnsupportedParagraph:
    line: int
    heading: str
    text: str


@dataclass
class UnsupportedSynthesisCandidate:
    count: int
    path: Path
    examples: list[UnsupportedParagraph]


@dataclass
class StaleSynthesisCandidate:
    note: PageProfile
    related_sources: list[tuple[float, PageProfile, list[str]]]


@dataclass
class BridgeNoteCandidate:
    term: str
    count: int
    distinct_files: int
    source_files: int
    examples: list[Path]


def rel(path: Path) -> str:
    return path.relative_to(REPO_ROOT).as_posix()


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def wiki_source_files() -> list[Path]:
    return sorted(WIKI_SOURCES_DIR.glob("*.md"))


def wiki_note_files() -> list[Path]:
    return sorted(path for path in WIKI_NOTES_DIR.glob("*.md") if path.name != ".gitkeep")


def parse_note_type(text: str) -> str | None:
    frontmatter = FRONTMATTER_RE.match(text)
    if not frontmatter:
        return None
    match = TYPE_RE.search(frontmatter.group(1))
    if not match:
        return None
    return match.group(1)


def is_external_link(target: str) -> bool:
    parsed = urlparse(target)
    return parsed.scheme in {"http", "https", "mailto", "tel"}


def normalize_link_target(target: str) -> str:
    target = target.strip()
    if target.startswith("<") and target.endswith(">"):
        target = target[1:-1]
    target = target.split("#", 1)[0]
    return unquote(target)


def resolve_local_link(source_file: Path, target: str) -> Path | None:
    target = normalize_link_target(target)
    if not target or is_external_link(target):
        return None
    if target.startswith("/"):
        return REPO_ROOT / target.lstrip("/")
    return (source_file.parent / target).resolve()


def check_local_links(path: Path, findings: list[Finding]) -> None:
    text = read_text(path)
    for match in LOCAL_LINK_RE.finditer(text):
        target = match.group(1)
        resolved = resolve_local_link(path, target)
        if resolved is None:
            continue
        try:
            resolved.relative_to(REPO_ROOT)
        except ValueError:
            findings.append(Finding("ERROR", f"local link escapes repo: `{target}`", rel(path)))
            continue
        if not resolved.exists():
            findings.append(Finding("ERROR", f"broken local link target: `{target}`", rel(path)))


def check_sources(findings: list[Finding]) -> None:
    index_text = read_text(INDEX_PATH) if INDEX_PATH.exists() else ""
    for source_page in wiki_source_files():
        slug = source_page.stem
        raw_dir = RAW_DIR / slug
        agent_dir = AGENT_DIR / slug
        if not raw_dir.is_dir():
            findings.append(Finding("ERROR", "missing matching raw source directory", rel(source_page)))
        if not agent_dir.is_dir():
            findings.append(Finding("ERROR", "missing matching agent package directory", rel(source_page)))
            continue
        for filename in REQUIRED_AGENT_FILES:
            if not (agent_dir / filename).is_file():
                findings.append(Finding("ERROR", f"missing required agent package file `{filename}`", rel(agent_dir)))
        check_metadata(slug, agent_dir, findings)
        if slug not in index_text:
            findings.append(Finding("ERROR", "source page missing from wiki index", rel(source_page)))


def check_metadata(slug: str, agent_dir: Path, findings: list[Finding]) -> None:
    metadata_path = agent_dir / "metadata.json"
    if not metadata_path.is_file():
        return
    try:
        data = json.loads(read_text(metadata_path))
    except json.JSONDecodeError as exc:
        findings.append(Finding("ERROR", f"invalid JSON metadata: {exc}", rel(metadata_path)))
        return
    expected = {
        "source_id": slug,
        "raw_dir": f"raw/{slug}",
        "agent_dir": f"agent/{slug}",
    }
    for key, value in expected.items():
        if data.get(key) != value:
            findings.append(
                Finding("ERROR", f"metadata `{key}` is `{data.get(key)}`, expected `{value}`", rel(metadata_path))
            )


def check_notes(findings: list[Finding]) -> None:
    index_text = read_text(INDEX_PATH) if INDEX_PATH.exists() else ""
    for note in wiki_note_files():
        note_type = parse_note_type(read_text(note))
        if note_type not in VALID_NOTE_TYPES:
            findings.append(
                Finding(
                    "ERROR",
                    f"frontmatter type must be one of `{sorted(VALID_NOTE_TYPES)}`, found `{note_type}`",
                    rel(note),
                )
            )
        if note.stem not in index_text:
            findings.append(Finding("ERROR", "note page missing from wiki index", rel(note)))


def run_qmd_status() -> str:
    wrapper = REPO_ROOT / "scripts" / "qmd-wiki"
    if not wrapper.is_file():
        return "QMD wrapper missing: `scripts/qmd-wiki`"
    try:
        completed = subprocess.run(
            [str(wrapper), "status"],
            cwd=REPO_ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=90,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return f"QMD status unavailable: {exc}"
    return completed.stdout.strip()


def structural_lint(include_qmd: bool) -> tuple[list[Finding], str]:
    findings: list[Finding] = []
    for required in (RAW_DIR, AGENT_DIR, WIKI_DIR, WIKI_SOURCES_DIR, WIKI_NOTES_DIR, INDEX_PATH):
        if not required.exists():
            findings.append(Finding("ERROR", "required path is missing", rel(required) if required.is_relative_to(REPO_ROOT) else str(required)))
    if findings:
        return findings, ""
    check_sources(findings)
    check_notes(findings)
    for path in [*wiki_source_files(), *wiki_note_files(), INDEX_PATH]:
        check_local_links(path, findings)
    qmd_status = run_qmd_status() if include_qmd else "Skipped by command option."
    return findings, qmd_status


def tokenize_stem(stem: str) -> set[str]:
    stop = {"and", "for", "from", "with", "into", "agent", "agents", "rtl", "llm", "en", "zh", "vs"}
    return {word for word in stem.split("-") if len(word) > 2 and word not in stop}


def semantic_tokens(text: str) -> set[str]:
    return {
        word
        for word in WORD_RE.findall(text.lower())
        if len(word) > 2 and not word.isdigit() and word not in SEMANTIC_TOKEN_STOP
    }


def jaccard(left: set[str], right: set[str]) -> float:
    if not left or not right:
        return 0.0
    return len(left & right) / len(left | right)


def snippet(text: str, limit: int = 220) -> str:
    collapsed = re.sub(r"\s+", " ", text).strip()
    if len(collapsed) <= limit:
        return collapsed
    return collapsed[: limit - 3].rstrip() + "..."


def first_heading(text: str) -> tuple[str, int]:
    for line_number, line in enumerate(text.splitlines(), start=1):
        match = HEADING_RE.match(line)
        if match:
            return match.group(2).strip("` "), line_number
    return "Untitled", 1


def extract_source_slugs(text: str) -> set[str]:
    slugs: set[str] = set()
    for match in LOCAL_LINK_RE.finditer(text):
        target = normalize_link_target(match.group(1))
        if not target.endswith(".md") or "sources/" not in target:
            continue
        slugs.add(Path(target).stem)
    return slugs


def page_profile(path: Path) -> PageProfile:
    text = read_text(path)
    title, title_line = first_heading(text)
    backtick_terms = {
        normalized
        for normalized in (normalized_backtick_term(term) for term in BACKTICK_TERM_RE.findall(text))
        if normalized and not is_noisy_bridge_term(normalized)
    }
    return PageProfile(
        path=path,
        title=title,
        page_type=parse_note_type(text),
        title_line=title_line,
        slug_tokens=tokenize_stem(path.stem),
        title_tokens=semantic_tokens(title),
        body_tokens=semantic_tokens(text),
        backtick_terms=backtick_terms,
        source_slugs=extract_source_slugs(text),
    )


def top_overlap(left: set[str], right: set[str], limit: int = 6) -> list[str]:
    return sorted(left & right)[:limit]


def duplicate_note_candidates(notes: list[Path], limit: int = 20) -> list[DuplicateNoteCandidate]:
    profiles = [page_profile(note) for note in notes]
    scored: list[DuplicateNoteCandidate] = []
    for index, left in enumerate(profiles):
        for right in profiles[index + 1 :]:
            stem_overlap = top_overlap(left.slug_tokens, right.slug_tokens)
            title_overlap = top_overlap(left.title_tokens, right.title_tokens)
            source_overlap = top_overlap(left.source_slugs, right.source_slugs)
            backtick_overlap = top_overlap(left.backtick_terms, right.backtick_terms)
            score = (
                0.40 * jaccard(left.slug_tokens, right.slug_tokens)
                + 0.25 * jaccard(left.title_tokens, right.title_tokens)
                + 0.25 * jaccard(left.source_slugs, right.source_slugs)
                + 0.10 * jaccard(left.backtick_terms, right.backtick_terms)
            )
            if left.page_type and left.page_type == right.page_type:
                score += 0.03
            if score < 0.22:
                continue
            rationale = []
            if stem_overlap:
                rationale.append(f"filename terms: {', '.join(stem_overlap)}")
            if title_overlap:
                rationale.append(f"title terms: {', '.join(title_overlap)}")
            if source_overlap:
                rationale.append(f"shared sources: {', '.join(source_overlap)}")
            if backtick_overlap:
                rationale.append(f"shared backtick terms: {', '.join(backtick_overlap)}")
            scored.append(DuplicateNoteCandidate(score, left, right, rationale))
    return sorted(scored, reverse=True, key=lambda item: item.score)[:limit]


def paragraphs_with_context(text: str) -> list[UnsupportedParagraph]:
    paragraphs: list[UnsupportedParagraph] = []
    current_heading = "Document"
    current_start = 1
    current_lines: list[str] = []
    in_frontmatter = text.startswith("---\n")

    def flush() -> None:
        nonlocal current_lines
        paragraph = "\n".join(current_lines).strip()
        if paragraph:
            paragraphs.append(UnsupportedParagraph(current_start, current_heading, paragraph))
        current_lines = []

    for line_number, line in enumerate(text.splitlines(), start=1):
        if in_frontmatter:
            if line_number > 1 and line == "---":
                in_frontmatter = False
            continue
        heading_match = HEADING_RE.match(line)
        if heading_match:
            flush()
            current_heading = heading_match.group(2).strip()
            continue
        if not line.strip():
            flush()
            continue
        if not current_lines:
            current_start = line_number
        current_lines.append(line)
    flush()
    return paragraphs


def normalized_heading(heading: str) -> str:
    return " ".join(WORD_RE.findall(heading.lower()))


def is_related_link_heading(heading: str) -> bool:
    normalized = normalized_heading(heading)
    if normalized in {
        "related pages",
        "related notes",
        "related sources",
        "related links",
        "see also",
        "further reading",
    }:
        return True
    related_link_words = {"page", "pages", "note", "notes", "source", "sources", "link", "links"}
    if normalized.startswith("related ") and any(
        word in normalized.split() for word in related_link_words
    ):
        return True
    return False


def is_mostly_link_paragraph(text: str) -> bool:
    links = MARKDOWN_LINK_RE.findall(text)
    if len(links) < 2:
        return False
    prose = MARKDOWN_LINK_RE.sub(" ", text)
    prose = re.sub(r"[`*_>\-\s]+", " ", prose)
    prose_words = WORD_RE.findall(prose.lower())
    link_density = sum(len(link) for link in links) / max(len(text), 1)
    return link_density >= 0.55 or len(prose_words) <= 8


def unsupported_synthesis_candidates(notes: list[Path], limit: int = 20) -> list[UnsupportedSynthesisCandidate]:
    candidates: list[UnsupportedSynthesisCandidate] = []
    for note in notes:
        text = read_text(note)
        if parse_note_type(text) not in {"concept", "comparison", "overview", "synthesis"}:
            continue
        claim_like = [
            paragraph
            for paragraph in paragraphs_with_context(text)
            if len(paragraph.text) > 180
            and not paragraph.text.startswith("#")
            and not is_related_link_heading(paragraph.heading)
            and not is_mostly_link_paragraph(paragraph.text)
            and not SOURCE_LINK_RE.search(paragraph.text)
        ]
        if claim_like:
            candidates.append(UnsupportedSynthesisCandidate(len(claim_like), note, claim_like[:3]))
    return sorted(candidates, reverse=True, key=lambda item: item.count)[:limit]


def stale_synthesis_candidates(notes: list[Path], sources: list[Path]) -> list[StaleSynthesisCandidate]:
    note_profiles = [
        page_profile(note) for note in notes if parse_note_type(read_text(note)) in {"overview", "synthesis"}
    ]
    source_profiles = [page_profile(source) for source in sources]
    candidates: list[StaleSynthesisCandidate] = []
    for note in note_profiles:
        related: list[tuple[float, PageProfile, list[str]]] = []
        note_interest = note.slug_tokens | note.title_tokens | note.backtick_terms
        for source in source_profiles:
            if source.path.stem in note.source_slugs:
                continue
            source_interest = source.slug_tokens | source.title_tokens | source.backtick_terms
            overlap = top_overlap(note_interest, source_interest, 8)
            if len(overlap) < 2:
                continue
            score = jaccard(note_interest, source_interest)
            if score >= 0.08:
                related.append((score, source, overlap))
        related = sorted(related, reverse=True, key=lambda item: item[0])[:5]
        candidates.append(StaleSynthesisCandidate(note, related))
    return sorted(
        candidates,
        key=lambda item: (
            -(item.related_sources[0][0] if item.related_sources else -1.0),
            rel(item.note.path),
        ),
    )


def normalized_backtick_term(term: str) -> str:
    return "-".join(WORD_RE.findall(term.lower()))


def is_noisy_bridge_term(term: str) -> bool:
    generic_terms = {"rtl", "llm", "llms", "eda", "ai", "json", "pdf", "api", "cpu", "gpu"}
    return term in generic_terms or bool(NOISY_BRIDGE_TERM_RE.match(term))


def repeated_terms_without_notes(paths: list[Path], notes: list[Path], limit: int = 20) -> list[BridgeNoteCandidate]:
    note_stems = {note.stem for note in notes}
    counter: Counter[str] = Counter()
    term_paths: dict[str, set[Path]] = {}
    for path in paths:
        text = read_text(path)
        for term in BACKTICK_TERM_RE.findall(text):
            normalized = normalized_backtick_term(term)
            if len(normalized) < 3:
                continue
            counter[normalized] += 1
            term_paths.setdefault(normalized, set()).add(path)
    scored: list[tuple[float, BridgeNoteCandidate]] = []
    for term, count in counter.most_common():
        if count < 3:
            continue
        if is_noisy_bridge_term(term):
            continue
        if term not in note_stems and not any(term in stem for stem in note_stems):
            paths_for_term = term_paths[term]
            source_count = sum(1 for path in paths_for_term if path.is_relative_to(WIKI_SOURCES_DIR))
            score = count + (2 * len(paths_for_term)) + source_count
            examples = sorted(paths_for_term, key=lambda path: (not path.is_relative_to(WIKI_SOURCES_DIR), rel(path)))[:4]
            scored.append((score, BridgeNoteCandidate(term, count, len(paths_for_term), source_count, examples)))
    return [candidate for _, candidate in sorted(scored, reverse=True, key=lambda item: item[0])[:limit]]


def semantic_review_packet() -> list[str]:
    notes = wiki_note_files()
    sources = wiki_source_files()
    lines: list[str] = [
        "## Semantic Review Packet",
        "",
        "This section is intentionally agent-reviewed. The script gathers candidates; the reviewing agent must use QMD search and targeted page reads before writing final semantic findings.",
        "",
        "### Required Review Questions",
        "",
        "- Hidden conflicts: are incompatible claims explicitly discussed, scoped, or marked unresolved?",
        "- Stale synthesis: do overview and synthesis notes reflect newer source pages that materially sharpen or contradict them?",
        "- Unsupported synthesis: do strong wiki-note claims point to source pages?",
        "- Duplicate-note risk: are overlapping notes merged, cross-linked, or clearly scoped?",
        "- Missing bridge notes: do repeated cross-source ideas have reusable notes when they should?",
        "",
        "### Duplicate-Note Candidates",
        "",
    ]
    duplicates = duplicate_note_candidates(notes)
    if duplicates:
        for candidate in duplicates:
            rationale = "; ".join(candidate.rationale) if candidate.rationale else "combined title/source/content overlap"
            lines.append(
                f"- review {candidate.score:.2f}: `{rel(candidate.left.path)}:{candidate.left.title_line}` "
                f"and `{rel(candidate.right.path)}:{candidate.right.title_line}` - {rationale}"
            )
    else:
        lines.append("- no duplicate-note candidates found")
    lines.extend(["", "### Unsupported-Synthesis Candidates", ""])
    unsupported = unsupported_synthesis_candidates(notes)
    if unsupported:
        for candidate in unsupported:
            lines.append(
                f"- review `{rel(candidate.path)}`: {candidate.count} long paragraph(s) without direct source-page links"
            )
            for paragraph in candidate.examples:
                lines.append(
                    f"  - `{rel(candidate.path)}:{paragraph.line}` under \"{paragraph.heading}\": "
                    f"{snippet(paragraph.text)}"
                )
    else:
        lines.append("- no long unsourced paragraph candidates found")
    lines.extend(["", "### Stale-Synthesis Review Targets", ""])
    stale = stale_synthesis_candidates(notes, sources)
    if stale:
        for candidate in stale:
            lines.append(
                f"- review `{rel(candidate.note.path)}:{candidate.note.title_line}` "
                "against related source pages not directly linked from the note"
            )
            if candidate.related_sources:
                for score, source, overlap in candidate.related_sources:
                    lines.append(
                        f"  - {score:.2f}: `{rel(source.path)}:{source.title_line}` "
                        f"overlap terms: {', '.join(overlap)}"
                    )
            else:
                lines.append("  - no related-source hints found")
    else:
        lines.append("- no overview or synthesis notes found")
    lines.extend(["", "### Missing Bridge-Note Candidates", ""])
    repeated_terms = repeated_terms_without_notes([*sources, *notes], notes)
    if repeated_terms:
        for candidate in repeated_terms:
            examples = ", ".join(f"`{rel(path)}`" for path in candidate.examples)
            lines.append(
                f"- review `{candidate.term}`: {candidate.count} backtick mentions across "
                f"{candidate.distinct_files} file(s), including {candidate.source_files} source page(s); examples: {examples}"
            )
    else:
        lines.append("- no repeated backtick-term candidates found")
    lines.extend(["", "### Review Procedure", ""])
    lines.append("- Start from `wiki/index.md`, then in Codex use MCP `qmd-wiki.query` for discovery.")
    lines.append("- Use `scripts/qmd-wiki query \"<candidate or conflict>\"` only as a CLI fallback outside Codex.")
    lines.append("- Read exact source and note pages before recording any semantic finding.")
    lines.append("- Treat conflicts as healthy when they are visible; only hidden or unsupported conflicts are lint issues.")
    lines.append("- Do not auto-fix from this report; update the relevant wiki note deliberately after review.")
    return lines


def render_report(mode: str, result: LintResult) -> str:
    today = dt.date.today().isoformat()
    counts = result.counts()
    lines = [
        "---",
        "type: meta",
        f"title: \"Wiki Lint Report {today}\"",
        f"created: {today}",
        f"updated: {today}",
        "status: generated",
        "---",
        "",
        f"# Wiki Lint Report: {today}",
        "",
        "## Summary",
        "",
        f"- Mode: `{mode}`",
        f"- Structural errors: {counts['ERROR']}",
        f"- Structural warnings: {counts['WARN']}",
        f"- Structural info: {counts['INFO']}",
        "- Semantic lint: agent-reviewed candidate packet, not automated judgment",
        "",
    ]
    if mode in {"structure", "all"}:
        lines.extend(["## Structural Findings", ""])
        if result.structure:
            lines.extend(finding.render() for finding in result.structure)
        else:
            lines.append("- PASS: no structural findings")
        lines.extend(["", "## QMD Status", "", "```text", result.qmd_status or "Not run.", "```", ""])
    if mode in {"semantic", "all"}:
        lines.extend(result.semantic)
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def report_path_for_today() -> Path:
    today = dt.date.today().isoformat()
    return WIKI_META_DIR / f"wiki-lint-{today}.md"


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Lint the LLM-wiki knowledge vault.")
    parser.add_argument("mode", choices=("structure", "semantic", "all"), help="lint layer to run")
    parser.add_argument("--stdout", action="store_true", help="print report without writing wiki/meta")
    parser.add_argument("--output", type=Path, help="custom report path; defaults to wiki/meta/wiki-lint-YYYY-MM-DD.md")
    parser.add_argument("--no-qmd", action="store_true", help="skip scripts/qmd-wiki status in structural lint")
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    result = LintResult()
    if args.mode in {"structure", "all"}:
        result.structure, result.qmd_status = structural_lint(include_qmd=not args.no_qmd)
    if args.mode in {"semantic", "all"}:
        result.semantic = semantic_review_packet()
    report = render_report(args.mode, result)
    if args.stdout:
        print(report, end="")
    else:
        output_path = args.output if args.output else report_path_for_today()
        output_path = output_path if output_path.is_absolute() else REPO_ROOT / output_path
        output_path.parent.mkdir(parents=True, exist_ok=True)
        output_path.write_text(report, encoding="utf-8")
        print(rel(output_path))
    return 1 if any(finding.level == "ERROR" for finding in result.structure) else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
